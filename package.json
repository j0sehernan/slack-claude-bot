{
  "name": "slack-claude-pr-review",
  "version": "1.0.0",
  "description": "Slack bot that reviews GitHub pull requests by delegating to the local Claude Code CLI.",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "./setup.sh",
    "start": "node index.js",
    "dev": "node --watch index.js",
    "autostart": "./install-autostart.sh",
    "logs": "tail -f logs/bot.log"
  },
  "keywords": [
    "slack",
    "claude",
    "claude-code",
    "bot",
    "code-review"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "dotenv": "^17.3.1"
  }
}
