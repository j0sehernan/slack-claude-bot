# ============================================================
# Slack Claude Bot — configuration
# Copy this file to .env and fill in the values.
# ============================================================

# ---- Required: Slack credentials -------------------------------------------
# Bot User OAuth Token. Starts with xoxb-...
# Found at: https://api.slack.com/apps -> your app -> OAuth & Permissions
SLACK_BOT_TOKEN=

# App-Level Token. Starts with xapp-...
# Found at: https://api.slack.com/apps -> your app -> Basic Information -> App-Level Tokens
# Required scope: connections:write
SLACK_APP_TOKEN=

# ---- Optional: behavior ----------------------------------------------------
# Slash command / skill to invoke automatically when the bot is mentioned.
# - If the user's message already starts with "/something", it is left as-is.
# - Otherwise this skill is prepended.  Set to empty to disable.
# Examples: pr-review, code-review, security-review
DEFAULT_SKILL=pr-review

# Working directory where the local `claude` CLI runs.
# Defaults to this repo's directory.  Change if you want claude to operate on
# a specific repo or workspace.  Use absolute paths.
# WORKING_DIR=/Users/me/code/my-repo

# Comma-separated list of Slack channel IDs the bot will respond in.
# Leave empty to allow all channels (default).  Channel IDs look like C0123ABCD.
# ALLOWED_CHANNELS=

# Comma-separated list of Slack user IDs allowed to trigger the bot.
# Leave empty to allow everyone in the workspace.  User IDs look like U0123ABCD.
# ALLOWED_USERS=

# Hard cap (in milliseconds) for a single Claude run before it is killed.
# Default: 600000 (10 minutes).
# CLAUDE_TIMEOUT_MS=600000

# Set to "1" to print Claude stderr to the bot logs (useful for debugging).
# DEBUG=0
